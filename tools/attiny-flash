#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

package_name="com.example.attinyflash"
action="${1:-}"
request_id="cli-$(date +%s)-$$-$RANDOM"
result_dir="/storage/emulated/0/Download/AttinyFlash"
result_file="$result_dir/$request_id.log"

case "$action" in
    signature)
        ;;
    flash)
        if [ "$#" -ne 2 ]; then
            echo "Usage: attiny-flash signature | attiny-flash flash /path/to/firmware.hex" >&2
            exit 2
        fi
        firmware="$2"
        ;;
    *)
        echo "Usage: attiny-flash signature | attiny-flash flash /path/to/firmware.hex" >&2
        exit 2
        ;;
esac

mkdir -p "$result_dir"
timeout 600 sh -c '
    tail -n 0 -F "$1" | awk -v request_id="$2" '"'"'
        index($0, request_id) {
            print
            fflush()
            if ($0 ~ /RESULT success/) exit 0
            if ($0 ~ /ERROR/) exit 1
        }
    '"'"'
' sh "$result_file" "$request_id" &
listener_pid=$!
trap 'kill "$listener_pid" 2>/dev/null || true' EXIT
sleep 0.2

command=(/system/bin/am start-foreground-service --user 0 -n "$package_name/.FlashService"
    --es action "$action"
    --es requestId "$request_id")
if [ "$action" = "flash" ]; then
    command+=(--es firmware "$firmware")
fi
"${command[@]}" >/dev/null
if wait "$listener_pid"; then
    exit 0
else
    result=$?
    if [ "$result" -eq 124 ]; then
        echo "Timed out waiting for the app. Check USB permission and All files access in the app." >&2
    fi
    exit "$result"
fi
